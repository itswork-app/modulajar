{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://modulajar.app/schemas/domain/artifact_metadata.schema.json",
    "title": "ArtifactMetadata",
    "description": "Schema for the metadata column in the documents table",
    "type": "object",
    "properties": {
        "pdf_sha256": {
            "type": "string"
        },
